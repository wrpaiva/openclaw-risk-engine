# Sem credenciais reais. Limites financeiros NÃO são configurados por ambiente:
# vivem em políticas versionadas e aprovadas (SPEC §11.2, ADR-0005).
# Valores numéricos não têm default: defina-os explicitamente.
NODE_ENV=development
RISK_ENVIRONMENT=PAPER
# Credencial de RUNTIME (login membro de openclaw_risk_runtime): exatamente UMA das duas, descomentada.
# Em deploy prefira o arquivo (montado pelo orquestrador); o conteúdo é a URL de conexão, nunca versionada.
# A URL direta aparece em `docker inspect` e em /proc/<pid>/environ; o arquivo (_FILE) não.
# RISK_DATABASE_URL=
# RISK_DATABASE_URL_FILE=
RISK_LOG_LEVEL=info
RISK_CLOCK_SKEW_TOLERANCE_MS=
RISK_DB_CONNECTION_TIMEOUT_MS=
RISK_DB_STATEMENT_TIMEOUT_MS=
RISK_DB_LOCK_TIMEOUT_MS=
RISK_HTTP_ENABLED=false
# Escopo de bind (ADR-0011): loopback (default) ou private-network.
RISK_HTTP_BIND_SCOPE=loopback
# Só com private-network (e então obrigatório): RISK_HTTP_TRANSPORT=plaintext-encrypted-overlay
# RISK_HTTP_TRANSPORT=
# Obrigatórios quando RISK_HTTP_ENABLED=true. Host: loopback = IP 127.0.0.0/8 ou ::1; private-network = só o curinga IPv4 canônico.
RISK_HTTP_HOST=
RISK_HTTP_PORT=
RISK_HTTP_MAX_BODY_BYTES=
RISK_HTTP_REQUEST_TIMEOUT_MS=
RISK_HTTP_HEADERS_TIMEOUT_MS=
# JSON {version:1, principals:[{principalId, kind, tokenSha256:[...]}]}; só hashes, nunca tokens.
RISK_PRINCIPALS_FILE=
# Credencial de MIGRAÇÃO (dona do schema, openclaw_risk_owner): só para a CLI do operador (`migrate`,
# `reconcile-after-restore`, `mark-restore-pending`; scripts/migrate.sh); NUNCA no ambiente do servidor (o boot recusa).
# Exatamente UMA das duas. Essas CLIs exigem também RISK_ENVIRONMENT=PAPER e os três RISK_DB_*_TIMEOUT_MS acima
# (conexão, statement e lock; sem valor padrão: defina-os explicitamente):
# RISK_MIGRATION_DATABASE_URL=
# RISK_MIGRATION_DATABASE_URL_FILE=
