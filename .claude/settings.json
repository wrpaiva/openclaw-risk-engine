{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(sh scripts/check.sh)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npm run test:db *)",
      "Bash(sh scripts/test-db.sh *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(psql *)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Bash(docker service create *)",
      "Bash(docker service update *)",
      "Bash(docker stack deploy *)"
    ]
  },
  "hooks": {
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run --silent typecheck >&2 && npm run --silent test:unit >/dev/null 2>&1 || { echo \"Portão de qualidade: typecheck ou testes unitários falhando; corrija antes de concluir a tarefa (rode npm run typecheck && npm run test:unit).\" >&2; exit 2; }",
            "timeout": 300,
            "statusMessage": "Portão de qualidade: typecheck + testes unitários"
          }
        ]
      }
    ]
  }
}
