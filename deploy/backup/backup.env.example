# EXEMPLO — NÃO APLICADO. Configuração NÃO secreta de scripts/backup-prod.sh (ADR-0012). Copie para fora do repositório
# (ex.: dentro do diretório de deploy da VPS, 0600) e preencha na etapa de deploy, com aprovação do usuário.
# Linhas CHAVE=VALOR, sem aspas nem expansão. Nenhum valor abaixo foi decidido: tudo "a definir".
# Segredos NÃO entram aqui: ficam em arquivos 0400 dentro de RISK_BACKUP_SECRETS_DIR (pgpass, age_recipients, rclone.conf).
RISK_BACKUP_EXPECTED_DB=openclaw_risk
# Diretórios absolutos, existentes, não symlink, do uid que roda o cron, modo 0700. Proposto no ADR: dentro de /opt/openclaw-risk-engine (a definir; U8).
RISK_BACKUP_DIR=<a definir>
RISK_BACKUP_SECRETS_DIR=<a definir>
# Provedor, bucket, região e prefixo: a definir (U4). A região vai no rclone.conf.
RISK_BACKUP_S3_BUCKET=<a definir>
RISK_BACKUP_S3_PREFIX=<a definir>
# Imagem local construída com `npm run image:build:backup` (openclaw-risk-backup:<versão>).
RISK_BACKUP_IMAGE=openclaw-risk-backup:<versão>
# Rede Docker que alcança o PostgreSQL e o endpoint S3 (a definir; U3). O host/porta do banco ficam no pgpass.
RISK_BACKUP_DOCKER_NETWORK=<a definir>
